model Submission {
  id            String           @id @default(uuid())
  projectName   String
  repoUrl       String           @unique
  liveLink      String
  description   String           @db.Text
  status        SubmissionStatus @default(PENDING)
  reviewComment String?          @db.Text
  reviewedAt    DateTime?

  studentId     String
  student       User             @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  reviewedById  String?
  reviewedBy    User?            @relation("MentorReviews", fields: [reviewedById], references: [id])

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status])
  @@index([studentId])
}